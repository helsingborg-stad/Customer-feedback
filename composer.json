{
    "name": "helsingborg-stad/customer-feedback",
    "description": "This WordPress plugin adds a feedback form to the end of every page (or any other activated post type).",
    "type": "wordpress-plugin",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/helsingborg-stad/acf-export-manager.git"
        }
    ],
    "authors": [
        {
            "name": "Kristoffer Svanmark",
            "email": "kristoffer.svanmark@lexiconitkonsult.se"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit",
        "lint": "vendor/bin/mago lint",
        "fix": "vendor/bin/mago lint --format-after-fix --fix",
        "format": "vendor/bin/mago fmt"
    },
    "require": {
        "helsingborg-stad/acf-export-manager": ">=1.0.0",
        "helsingborg-stad/component-library": "^5.0.0",
        "helsingborg-stad/wputilservice": "0.3",
        "helsingborg-stad/wpservice": "^2.0"
    },
    "suggest": {
        "helsingborg-stad/municipio": "^6.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "carthage-software/mago": "^1.0.0-rc.3"
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true
        }
    },
    "autoload": {
        "psr-4": {
            "CustomerFeedback\\": "source/php/"
        }
    }
}